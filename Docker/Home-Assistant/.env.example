COMPOSE_PROJECT_NAME=home-assistant

# Timezone for the Home Assistant container (IANA tz name)
TZ=Europe/Zurich

# Authentik OIDC client id for the hass-oidc-auth login (public client, so there
# is no secret). Written by Docker/Authentik/scripts/provision-admin-sso.py
# (via apply-sso-env.py) - rerun that instead of typing it in.
HA_OIDC_CLIENT_ID=
