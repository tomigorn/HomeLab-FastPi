[Unit]
Description=ClamAV scan of new files on seagate-red and seagate-black
Documentation=file:///home/pi/Projects/Docker/antivirus/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=pi
Group=pi
SupplementaryGroups=docker
ExecStart=/usr/bin/docker exec clamav /scan.sh new
# Exit 1 = infected files found and quarantined; the alert reports those, the unit only fails on scan errors.
SuccessExitStatus=1
TimeoutStartSec=6h
NoNewPrivileges=true
PrivateTmp=true
