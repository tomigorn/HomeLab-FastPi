COMPOSE_PROJECT_NAME=crowdsec
CROWDSEC_IMAGE=crowdsecurity/crowdsec
# Bumped automatically by scripts/crowdsec-autoupdate.sh (daily, patch/minor only;
# a new major waits for a human). See README "Auto-update".
CROWDSEC_TAG=v1.8.2
# on | off. off pauses the daily auto-update (image AND hub content), e.g. to keep
# a manual rollback in place.
CROWDSEC_AUTOUPDATE=on
