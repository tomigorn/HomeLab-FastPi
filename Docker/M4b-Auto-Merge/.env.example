COMPOSE_PROJECT_NAME=m4b-auto-merge

# Local time, so the weekly sweep fires at the hour you expect
TZ=Europe/Zurich

# The Audiobookshelf library and the quarantine the originals move into
LIB_DIR=/mnt/seagate-black/library/audiobooks
QUARANTINE_DIR=/mnt/seagate-black/m4b-originals-quarantine

# Where orchestrate.py lives. Mounted at the SAME path inside the container so
# the script's built-in absolute defaults keep working.
MERGE_DIR=/home/pi/Projects/Docker/audiobookshelf/m4b-merge

# The tree must be quiet this long before a merge starts, so a copy still in
# progress is never merged half-written.
QUIET_SECONDS=300

# If another merge holds the lock (the big batch, say), wait this long and retry
RETRY_SECONDS=900

# Parallel books per run. beefy has 12 cores.
JOBS=10

# Weekly safety sweep. Mon=0 .. Sat=5, Sun=6
SWEEP_DOW=5
SWEEP_HOUR=4
SWEEP_MINUTE=0
