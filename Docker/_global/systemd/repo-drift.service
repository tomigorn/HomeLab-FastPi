[Unit]
Description=Repo-vs-live drift: compose, units, scripts, /etc and uncommitted files against the repo
Documentation=file:///home/pi/Projects/Docker/_global/scripts/README.md
After=docker.service

[Service]
Type=oneshot
User=pi
Group=pi
Environment=HOME=/home/pi
ExecStart=/usr/bin/python3 -I /home/pi/Projects/Docker/_global/scripts/repo_drift.py --host fastpi --prom /var/lib/node-exporter/textfile/repo_drift.prom --json /home/pi/.local/state/repo-drift/drift.json
TimeoutStartSec=600
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/node-exporter/textfile /home/pi/.local/state/repo-drift
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
