[Unit]
Description=Telegram warnings for the estimated MyAnonamouse bonus points (no calls to MAM)
Documentation=file:///home/pi/Projects/Docker/_global/scripts/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
StateDirectory=mam-points
Environment=HOME=/home/pi
ExecStart=/usr/bin/python3 /home/pi/Projects/Docker/_global/scripts/mam-points.py check
TimeoutStartSec=120
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/node-exporter/textfile
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
