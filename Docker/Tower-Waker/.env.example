COMPOSE_PROJECT_NAME=tower-waker

# 9001 is Beefy-Waker.
WAKER_LISTEN_PORT=9002
WAKER_BIND=192.168.1.2

TARGET_MAC=60:be:b4:17:0d:e0
TARGET_BROADCAST=192.168.1.255
TARGET_PROBE_HOST=192.168.1.101

# 8080 (Nextcloud), NOT 22.
# On Unraid, SSH answers ~21s before the array is mounted, so a port-22 probe
# reports ready while /mnt is still empty. Nextcloud cannot answer until Docker
# started, which cannot happen until the array mounted.
TARGET_PROBE_PORT=8080

# Measured cold boot to a fully mounted array is 102s; beefys 60 would expire
# while tower is still booting.
WAKE_COUNTDOWN=120

# /history does not work for tower: Unraid is not systemd and has no journalctl.
# Left set for completeness; the endpoint will simply fail.
TARGET_SSH_USER=root
TARGET_HISTORY_SINCE=0

# --- Wake retry ---
# One magic packet is not enough: a machine that has just been told to power off
# ignores packets until it truly reaches S5, and that window is variable.
# The waker resends every WAKE_RETRY_INTERVAL seconds until the host answers,
# giving up after WAKE_RETRY_WINDOW.
WAKE_RETRY_INTERVAL=20
WAKE_RETRY_WINDOW=300
