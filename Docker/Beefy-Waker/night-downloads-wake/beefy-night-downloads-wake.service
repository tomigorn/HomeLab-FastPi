[Unit]
Description=Wake beefy at 22:05 when downloads wait for the night
Documentation=file:///home/pi/Projects/Docker/Beefy-Waker/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# pi, not root: the script is pi-writable; beefy-maintenance-wake needs no root (Waker HTTP, wakeonlan, ping).
User=pi
Group=pi
ExecStart=/home/pi/Projects/Docker/Beefy-Waker/night-downloads-wake/beefy-night-downloads wake
TimeoutStartSec=330
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
