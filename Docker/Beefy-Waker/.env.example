COMPOSE_PROJECT_NAME=beefy-waker

# Port the waker listens on (host network, on fastpi)
WAKER_LISTEN_PORT=9001

# beefy's NIC MAC — target of the Wake-on-LAN magic packet
BEEFY_MAC=74:56:3c:96:79:a3

# LAN broadcast address. Use the subnet broadcast (NOT 255.255.255.255):
# fastpi has many docker bridges, so a global broadcast can leave the wrong
# interface and never reach beefy.
BEEFY_BROADCAST=192.168.1.255

# Host:port TCP-probed to decide "is beefy up". Port 22 (SSH) = host is booted.
# Per-route overrides are possible via the forwardAuth query string (?port=...).
BEEFY_PROBE_HOST=192.168.1.102
BEEFY_PROBE_PORT=22

# Manual wake page (/) countdown, seconds — beefy's typical cold-boot time.
WAKE_COUNTDOWN=60

# SSH user for the /history boot-list fetch (read-only forced-command key).
BEEFY_SSH_USER=buntu
