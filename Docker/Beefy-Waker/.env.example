COMPOSE_PROJECT_NAME=beefy-waker

# Port the waker listens on (host network, on fastpi)
WAKER_LISTEN_PORT=9001

# Bind address for the listener. The LAN IP (not 0.0.0.0) so the raw port is NOT
# reachable from docker bridges / other interfaces; Traefik still reaches it here.
WAKER_BIND=192.168.1.2

# beefy's NIC MAC — target of the Wake-on-LAN magic packet
BEEFY_MAC=74:56:3c:96:79:a3

# LAN broadcast address. Use the subnet broadcast (NOT 255.255.255.255):
# fastpi has many docker bridges, so a global broadcast can leave the wrong
# interface and never reach beefy.
BEEFY_BROADCAST=192.168.1.255

# Host:port TCP-probed to decide "is beefy up". Port 22 (SSH) = host is booted.
# Per-route overrides are possible via the forwardAuth query string (?port=...).
BEEFY_PROBE_HOST=192.168.1.102
BEEFY_PROBE_PORT=22

# Manual wake page (/) countdown, seconds — beefy's typical cold-boot time.
WAKE_COUNTDOWN=60

# SSH user for the /history boot-list fetch (read-only forced-command key).
BEEFY_SSH_USER=buntu

# History cutoff: only show boots starting at/after this epoch-microseconds.
# 0 = show all. To start fresh (hide old experimental boots), set it to "now",
# e.g. the current boot's start:
#   curl -s http://192.168.1.2:9001/history | \
#     python3 -c "import sys,json;print([x for x in json.load(sys.stdin) if x['index']==0][0]['first_entry'])"
BEEFY_HISTORY_SINCE=0

# --- Wake retry ---
# One magic packet is not enough: a machine that has just been told to power off
# ignores packets until it truly reaches S5, and that window is variable.
# The waker resends every WAKE_RETRY_INTERVAL seconds until the host answers,
# giving up after WAKE_RETRY_WINDOW.
WAKE_RETRY_INTERVAL=20
WAKE_RETRY_WINDOW=300
