# Environment files (contain secrets) — keep .env.example tracked
.env
.env.*
!.env.example

# Keys & certificates
*.key
*.pem
*.crt
*.cert
*.csr
*.p12
*.pfx

# Credentials, secrets & tokens
secrets/
*.secret
*.token
credentials.json
auth.json

# Logs (may leak sensitive data)
*.log

# Authentik runtime data (bind mounts)
data/
certs/
# custom-templates is a bind mount, but the templates in it are SOURCE, not
# runtime data - and unlike blueprints/ this directory IS mounted, so what lives
# here is what authentik actually renders. Track the templates, ignore the rest.
custom-templates/*
!custom-templates/email/
custom-templates/email/*
!custom-templates/email/*.html
