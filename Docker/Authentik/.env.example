COMPOSE_PROJECT_NAME=authentik

# --- Authentik image ---
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.5.2

# --- PostgreSQL ---
PG_USER=authentik
PG_DB=authentik
# Generate: openssl rand -base64 36 | tr -d '\n'
PG_PASS=

# --- Authentik core ---
# Generate: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# --- Outbound email via Brevo transactional SMTP ---
# USERNAME = your Brevo SMTP login, PASSWORD = the Brevo SMTP key (not your
# account password). FROM must be on a domain you have authenticated
# (SPF/DKIM) in Brevo and Cloudflare DNS. Swap HOST/PORT for another provider.
AUTHENTIK_EMAIL__HOST=smtp-relay.brevo.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=Holy-Grail.ch <no-reply@holy-grail.ch>

# Web: single gunicorn worker (few users) — saves ~130 MB. Worker threads left
# at the recommended default of 2 (single worker replica).
AUTHENTIK_WEB__WORKERS=1
