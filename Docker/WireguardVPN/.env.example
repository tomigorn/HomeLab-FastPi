COMPOSE_PROJECT_NAME=wireguard-vpn

HOST_DOMAIN=zourdomain.com

PASSWORD_HASH=PasswordHashHere

# PASSWORD_HASH/HOST_DOMAIN above are v14-only (kept for the v14 rollback).
# v15 has no password login (DISABLE_PASSWORD_AUTH=true); the admin password
# lives only in its database - reset: docker exec -it WireGuard-VPN cli db:admin:reset

# Authentik OIDC client (written by Authentik/scripts/provision-admin-sso.py)
WG_EASY_OIDC_CLIENT_ID=
WG_EASY_OIDC_CLIENT_SECRET=
