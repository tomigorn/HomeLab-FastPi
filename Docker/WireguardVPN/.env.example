COMPOSE_PROJECT_NAME=wireguard-vpn

HOST_DOMAIN=zourdomain.com

PASSWORD_HASH=PasswordHashHere

# wg-easy v15 Admin Panel login (created in its first-run setup; v15 keeps it in its
# database - this is the record of it, not read by compose). PASSWORD_HASH/HOST_DOMAIN above are v14-only.
WG_EASY_ADMIN_USERNAME=admin
WG_EASY_ADMIN_PASSWORD=

# Authentik OIDC client (written by Authentik/scripts/provision-admin-sso.py)
WG_EASY_OIDC_CLIENT_ID=
WG_EASY_OIDC_CLIENT_SECRET=
