#!/bin/sh
# Notes: backlog, reminders and batch report layout, checked on the staged content (chained from the global pre-commit hook).
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
git diff --cached --name-only --diff-filter=ACMR -- docs/claude/batch-backlog.md docs/claude/reminders.md 'docs/claude/reports/20*.md' | while read -r f; do
  mkdir -p "$tmp/$(dirname "$f")"; git show ":$f" > "$tmp/$f"
done
files=$(find "$tmp" -name '*.md'); [ -n "$files" ] || exit 0
exec /home/pi/Projects/Docker/Notes/check-format.sh $files
