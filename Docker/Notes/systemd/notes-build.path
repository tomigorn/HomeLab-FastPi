[Unit]
Description=Notes site: rebuild right after a page in ~/notes/docs changes

[Path]
PathChanged=/home/pi/notes/docs
PathChanged=/home/pi/notes/docs/claude
PathChanged=/home/pi/notes/docs/claude/batches
PathChanged=/home/pi/notes/docs/claude/reports
PathChanged=/home/pi/notes/mkdocs.yml
Unit=notes-build.service

[Install]
WantedBy=paths.target
