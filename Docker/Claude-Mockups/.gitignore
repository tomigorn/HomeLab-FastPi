# ───────────────────────────────
# Environment & Secrets
# ───────────────────────────────
.env
.env.*
!.env.example

# ───────────────────────────────
# Demo content — throwaway mockups are not committed.
# Keep the folder in git via www/.gitkeep.
# ───────────────────────────────
/www/*
!/www/.gitkeep

# ───────────────────────────────
# Received answers — user selections, not committed.
# Keep the folder in git via answers/.gitkeep.
# ───────────────────────────────
/answers/*
!/answers/.gitkeep
