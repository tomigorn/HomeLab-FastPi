COMPOSE_PROJECT_NAME=cicd

# Jenkins runtime configuration
JENKINS_HTTP_PORT=8081
JENKINS_AGENT_PORT=50000
TZ=UTC
JENKINS_IMAGE=jenkins-custom:latest

# Admin credentials (do NOT commit real secrets into VCS)
JENKINS_ADMIN_ID=admin
# Set a strong password via an env file excluded from version control
JENKINS_ADMIN_PASSWORD=changeme

GITHUB_TOKEN_FILE=/run/secrets/github_token
GITHUB_CREDENTIAL_ID=github-app-id
