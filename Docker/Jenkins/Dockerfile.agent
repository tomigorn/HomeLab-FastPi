# ===============================================
# Jenkins ARM Agent with .NET 8, Docker, Flutter
# ===============================================
FROM jenkins/inbound-agent:latest

USER root

# 1️⃣ Install dependencies & Docker CLI
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg lsb-release git unzip && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# 2️⃣ Install .NET SDK 8
RUN apt-get update && \
    apt-get install -y wget apt-transport-https && \
    wget https://dotnetcli.azureedge.net/dotnet/Sdk/8.0.415/dotnet-sdk-8.0.415-linux-arm64.tar.gz -O /tmp/dotnet-sdk.tar.gz && \
    mkdir -p /usr/share/dotnet && \
    tar -zxf /tmp/dotnet-sdk.tar.gz -C /usr/share/dotnet && \
    rm /tmp/dotnet-sdk.tar.gz
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH=$DOTNET_ROOT:$PATH

# 3️⃣ Install Flutter
RUN git clone https://github.com/flutter/flutter.git /opt/flutter && \
    chmod +x /opt/flutter/bin/flutter
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"

# 4️⃣ Set working directory for Jenkins agent
RUN mkdir -p /home/jenkins/agent
WORKDIR /home/jenkins/agent

# 5️⃣ Copy entrypoint script and make executable
USER root
COPY scripts/agent-entrypoint.sh /usr/local/bin/agent-entrypoint.sh
RUN chmod +x /usr/local/bin/agent-entrypoint.sh

# 6️⃣ Use entrypoint
ENTRYPOINT ["/usr/local/bin/agent-entrypoint.sh"]

# Switch back to jenkins user
USER jenkins

# Agent ready to connect to Jenkins controller
