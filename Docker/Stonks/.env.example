# Docker Compose requires a lowercase project name.
COMPOSE_PROJECT_NAME=stonks

# Secrets are NOT here: they live in secrets/stonks.env (owner 65007, mode 0400),
# mounted as /app/.env and read by the app itself, single-quoted, '$' NOT doubled:
#   TELEGRAM_BOT_TOKEN='...'
#   APP_PASSWORD_HASH='$argon2id$v=19$...'   (docker compose run --rm stonks python hashpw.py)
#   SESSION_SECRET='...'

# Telegram
TELEGRAM_CHAT_ID=

# Web auth
APP_USERNAME=admin

# Behaviour
BASE_CURRENCY=CHF
DATABASE_PATH=/data/stonks.db
PRICE_POLL_MINUTES=10
SNAPSHOT_HOUR_CET=22
TZ=Europe/Zurich
