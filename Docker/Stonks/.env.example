# Docker Compose requires a lowercase project name.
COMPOSE_PROJECT_NAME=stonks

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web auth (generate hash with: docker compose run --rm stonks python hashpw.py)
# IMPORTANT: an argon2 hash contains '$' characters. Docker Compose interpolates
# '$' in env files, so you MUST double every '$' to '$$' in APP_PASSWORD_HASH below.
# Example: $argon2id$v=19$... becomes $$argon2id$$v=19$$...
APP_USERNAME=admin
APP_PASSWORD_HASH=
SESSION_SECRET=

# Behaviour
BASE_CURRENCY=CHF
DATABASE_PATH=/data/stonks.db
PRICE_POLL_MINUTES=10
SNAPSHOT_HOUR_CET=22
TZ=Europe/Zurich
