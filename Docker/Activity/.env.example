COMPOSE_PROJECT_NAME=activity

# Everything beefy- or qBittorrent-bound goes through Traefik's internal routes (entry point internal :8080, only from 172.24.255.10; ../Traefik/traefik/dynamic/activity-internal.yml).
# Beefy-Waker /status (never wakes beefy): beefy is polled only while it says "up": true.
WAKER_URL=http://traefik:8080/activity/waker
# activity-gate on beefy 192.168.1.102:8095 (nginx, read-only, injects the API keys, allow-lists the GET paths in README "Gate path contract").
GATE_URL=http://traefik:8080/activity/gate
# Polls (Waker, beefy if up, the audiobook sources) only while the page is viewed: every POLL_SECONDS while an /api/state came in within VIEWER_SECONDS; nothing otherwise.
POLL_SECONDS=30
VIEWER_SECONDS=120

# Audiobookshelf (traefik_proxy) with the API key in secrets/abs_api_key (needs admin: /api/sessions/open).
ABS_URL=http://audiobookshelf:8080
ABS_KEY_FILE=/run/secrets/abs_api_key
# qBittorrent of the mouse stack, category abr: the route allows only GET torrents/info?category=abr and needs no login (qBittorrent whitelists Traefik).
QBIT_URL=http://traefik:8080/activity/qbit

# Who may read the page and /api/state (Traefik's pinned address) and /metrics (the activity_metrics network = Prometheus).
PAGE_ALLOW=172.24.255.3/32,127.0.0.1/32
METRICS_ALLOW=10.24.40.0/29,127.0.0.1/32
# Jellyfin sees internet clients (Cloudflare tunnel -> Traefik) as the docker gateway: these addresses count as remote, not LAN.
TUNNEL_PEERS=172.24.0.1/32
LISTEN_PORT=8080
DATA_DIR=/data
