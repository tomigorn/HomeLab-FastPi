COMPOSE_PROJECT_NAME=activity

# Beefy-Waker /status on fastpi (host network): never wakes beefy. beefy is polled only while it says "up": true.
# off until the HOST-GUARD rule for 172.24.255.10 -> :9001 is applied (README "Owner steps"): the dropped probes would use up the drop-log budget. Then: http://192.168.1.2:9001
WAKER_URL=off
# activity-gate on beefy (nginx, read-only, injects the API keys, allow-lists the GET paths in README "Gate path contract").
GATE_URL=http://192.168.1.102:8097
# Seconds between polls of beefy and the audiobook sources; the Waker alone is asked every WAKER_SECONDS.
POLL_SECONDS=30
WAKER_SECONDS=15

# Audiobookshelf (traefik_proxy) with the API key in secrets/abs_api_key (needs admin: /api/sessions/open).
ABS_URL=http://audiobookshelf:8080
ABS_KEY_FILE=/run/secrets/abs_api_key
# qBittorrent of the mouse stack (gluetun_mouse on traefik_mouse), category abr; password in secrets/qbit_pass.
QBIT_URL=http://10.24.25.2:8080
QBIT_USER=admin
QBIT_PASS_FILE=/run/secrets/qbit_pass

# Who may read the page and /api/state (Traefik's pinned address) and /metrics (the activity_metrics network = Prometheus).
PAGE_ALLOW=172.24.255.3/32,127.0.0.1/32
METRICS_ALLOW=10.24.40.0/29,127.0.0.1/32
LISTEN_PORT=8080
DATA_DIR=/data
