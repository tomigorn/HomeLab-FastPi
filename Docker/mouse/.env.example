COMPOSE_PROJECT_NAME=mouse

# Secrets are files in secrets/, not variables (mode 0400):
#   wireguard_private_key     ProtonVPN WireGuard key (root:root, gluetun)
#   samba_account_mouse       Samba password of user mouse (root:root)
#   samba_account_books       Samba password of user books (root:root)
#   mousehole_auth_password   Mousehole web UI login (owner 65041)
#   qbit_pass                 qBittorrent web UI password (owner 65042, port-updater)
#   gluetun_auth_pass         gluetun control server password (owner 65042, port-updater)
#   port_updater_web_pass     port-updater status page password (owner 65042)

GLUETUN_AUTH_USER=username_here

WEB_PORT=8080

WEB_USER=admin
