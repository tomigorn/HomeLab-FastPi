COMPOSE_PROJECT_NAME=docker
PORTAINER_ADMIN_PASSWORD=
TRAEFIK_DOMAIN=example.com
# Authentik OIDC client (written by Authentik/scripts/provision-admin-sso.py)
PORTAINER_OAUTH_CLIENT_ID=
PORTAINER_OAUTH_CLIENT_SECRET=
# Docker socket proxy (filtered Docker API in front of Portainer)
SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy
SOCKET_PROXY_TAG=v0.5.0

# Same value as AGENT_SECRET in beefy Docker/Portainer-Agent/.env; agents only accept this Portainer.
AGENT_SECRET=
