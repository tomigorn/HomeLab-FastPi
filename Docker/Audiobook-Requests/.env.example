COMPOSE_PROJECT_NAME=audiobook-requests

# Secrets are files in secrets/, not variables (mode 0400):
#   abr_root_password        ABR root user (backup login), owner 65055
#   qbit_pass                qBittorrent web UI password (copy of mouse/secrets/qbit_pass), owner 65056
#   abs_api_key              Audiobookshelf API key "audiobook-importer" (empty = no scan), owner 65056
#   abr_api_key              ABR API key of the root user for scripts/abr-setup.py, owner pi
#   abr_oidc_client.json     Authentik client id + secret (provision-books-sso.py), owner pi

ABR_ROOT_USERNAME=abr-root
ABR_DEFAULT_REGION=us
# Empty = login type from the UI (oidc). Recovery: forms
ABR_FORCE_LOGIN_TYPE=
