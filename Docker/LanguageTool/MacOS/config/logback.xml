<?xml version="1.0" encoding="UTF-8"?>
<!--
  LanguageTool log configuration — ERROR level only.
  Mounted at /LanguageTool/logback.xml inside the container.
-->
<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="ERROR">
    <appender-ref ref="STDOUT"/>
  </root>

  <logger name="org.languagetool" level="WARN" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

</configuration>
