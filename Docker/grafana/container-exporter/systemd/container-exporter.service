[Unit]
Description=Container state textfile exporter, Telegram fallback when Prometheus or Alertmanager is down
Documentation=file:///home/pi/Projects/Docker/grafana/README.md
After=docker.service

[Service]
Type=oneshot
# Root: Docker's manual-stop flag lives only in /var/lib/docker/containers/*/config.v2.json.
StateDirectory=container-exporter
ExecStart=/usr/bin/python3 -I /usr/local/libexec/fastpi/container_exporter.py
TimeoutStartSec=90
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/node-exporter/textfile
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
