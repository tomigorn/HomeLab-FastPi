[[inputs.cpu]]
  percpu = true
  totalcpu = true
  collect_cpu_time = false
  report_active = false

[[inputs.mem]]
[[inputs.swap]]
[[inputs.disk]]
  ignore_fs = ["tmpfs","devtmpfs"]
[[inputs.net]]
[[inputs.system]]
[[inputs.processes]]
[[inputs.kernel]]
[[inputs.file]]
  files = ["/sys/class/thermal/thermal_zone0/temp"]
  name_override = "cpu_temperature"
  data_format = "value"
  data_type = "integer"

[[inputs.docker]]
  endpoint = "unix:///var/run/docker.sock"
  gather_services = false
  container_name_include = []
  container_name_exclude = []
  timeout = "5s"
  docker_label_include = []
  docker_label_exclude = []

[[secretstores.docker]]
  id = "docker_secretstore"

[[outputs.influxdb_v2]]
  urls = ["http://influxdb:8086"]
  # Token comes from the docker secret store (secrets/telegraf_influx_token), not from the env.
  token = "@{docker_secretstore:telegraf_influx_token}"
  organization = "myorg"
  bucket = "rpi"
