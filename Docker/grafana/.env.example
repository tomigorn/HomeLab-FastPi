COMPOSE_PROJECT_NAME=monitoring__grafana

GRAFANA_ADMIN_PASSWORD=your_secure_password_here
INFLUXDB_ADMIN_PASSWORD=your_secure_password_here
# InfluxDB API token telegraf uses to write metrics (injected into telegraf.conf)
INFLUX_TOKEN=your_influxdb_token_here
GRAFANA_INFLUX_TOKEN=
# Authentik OIDC client (written by Authentik/scripts/provision-admin-sso.py)
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=
