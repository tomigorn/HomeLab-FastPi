{
  "uid": "usage-per-user",
  "title": "Usage per user",
  "tags": [
    "usage",
    "seerr",
    "jellyfin",
    "audiobookshelf"
  ],
  "timezone": "Europe/Zurich",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests (Seerr)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per day",
      "description": "Requests created per day and user; follows the time range.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_fastpi"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_fastpi"
          },
          "query": "import \"timezone\"\noption location = timezone.location(name: \"Europe/Zurich\")\nfrom(bucket: \"usage\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"seerr_request\" and r._field == \"count\") |> group(columns: [\"user\"]) |> aggregateWindow(every: 1d, fn: sum, createEmpty: false, location: location) |> keep(columns: [\"_time\", \"_value\", \"user\"])"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Requests in selected range",
      "description": "Films and series only; audiobook and ebook requests are not tracked yet.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_fastpi"
      },
      "gridPos": {
        "h": 9,
        "w": 7,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "user"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "User"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "movie"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Films"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tv"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Series"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Total"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Total",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_fastpi"
          },
          "query": "from(bucket: \"usage\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"seerr_request\" and r._field == \"count\") |> group(columns: [\"user\", \"media_type\"]) |> sum() |> pivot(rowKey: [\"user\"], columnKey: [\"media_type\"], valueColumn: \"_value\") |> group() |> map(fn: (r) => ({r with total: (if exists r.movie then r.movie else 0) + (if exists r.tv then r.tv else 0)})) |> keep(columns: [\"user\", \"movie\", \"tv\", \"total\"]) |> sort(columns: [\"total\"], desc: true)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "_start": true,
              "_stop": true,
              "_time": true
            },
            "indexByName": {
              "user": 0,
              "movie": 1,
              "tv": 2,
              "total": 3
            }
          }
        }
      ]
    },
