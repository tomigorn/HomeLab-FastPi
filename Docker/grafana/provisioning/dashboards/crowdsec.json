     },
     "legendFormat": "parsed"
    },
    {
     "refId": "C",
     "expr": "clamp_min(sum(rate(cs_parser_hits_total[5m])) - sum(rate(cs_parser_hits_ok_total[5m])), 0) * 60",
     "datasource": {
