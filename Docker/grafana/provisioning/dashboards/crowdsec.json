  {
   "type": "stat",
   "title": "CrowdSec",
   "description": "Prometheus can scrape CrowdSec. When DOWN the bouncer fails OPEN (keeps the last ban list, lets everyone else through) and the CrowdSecDown alert fires after 10 min.",
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"crowdsec\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "dfc6abdxzsem8a"
     },
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "DOWN",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "UP",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
