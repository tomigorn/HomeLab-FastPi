  {
   "type": "timeseries",
   "title": "Requests blocked per hour",
   "description": "Bouncer = exact count of requests the CrowdSec bouncer refused (10-min resolution). Traefik 403 = every 403 on the public entrypoint, which also includes scanner filters and auth denials.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(crowdsec_bouncer_dropped_requests_total[30m])) * 3600",
     "datasource": {
      "type": "prometheus",
      "uid": "dfc6abdxzsem8a"
     },
     "legendFormat": "blocked by bouncer"
    },
    {
     "refId": "B",
     "expr": "sum(rate(traefik_entrypoint_requests_total{code=\"403\",entrypoint=\"websecure\"}[30m])) * 3600",
     "datasource": {
      "type": "prometheus",
      "uid": "dfc6abdxzsem8a"
     },
     "legendFormat": "all 403s (Traefik)"
    }
