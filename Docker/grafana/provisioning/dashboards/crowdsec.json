  {
   "type": "stat",
   "title": "Blocked (24h)",
   "description": "Requests the Traefik bouncer refused in the last 24 h - the bouncer's own count, reported to CrowdSec every 10 min (cscli metrics show bouncers). Exact, unlike the Traefik 403 count, which also includes 403s from other middlewares.",
   "targets": [
    {
     "refId": "A",
     "expr": "round(sum(increase(crowdsec_bouncer_dropped_requests_total[24h]))) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "dfc6abdxzsem8a"
     },
     "legendFormat": "",
     "instant": true,
     "range": false
