# Alertmanager — TEMPLATE. Copy to alertmanager.yml (gitignored) and fill in the
# marked values. The live file is not committed because this repo is public.
#
# Alertmanager does NOT expand ${ENV_VARS}, so values are written in literally.
# Secrets use the *_file options, which it does support, and live in secrets/.
#
# Both channels are ACTIVE and both were verified end to end by POSTing a synthetic
# alert to /api/v2/alerts — not assumed. Email proved itself on 2026-10-06 07:59
# (FIRING) / 08:04 (RESOLVED); Telegram likewise against the "holy grail alerts"
# group.
#
# Why Alertmanager and not Grafana contact points: the rules already live in
# prometheus/rules/*.yml, version-controlled and visible in the Prometheus UI.
# Grafana contact points only fire for GRAFANA-managed rules, so using them would
# have meant rewriting every rule in Grafana's format and leaving the Prometheus
# ones dead.
global:
  resolve_timeout: 5m
  # Reuses the Brevo relay Authentik already sends through: one mail account to keep
  # alive, one sender reputation, and no-reply@holy-grail.ch is already verified with
  # Brevo. The password is duplicated into secrets/smtp_password because there is no
  # shared secret store here yet.
  smtp_from: "Holy-Grail Alerts <no-reply@holy-grail.ch>"
  smtp_smarthost: "smtp-relay.brevo.com:587"
  smtp_auth_username: "YOUR_BREVO_SMTP_LOGIN"
  smtp_auth_password_file: /secrets/smtp_password
  smtp_require_tls: true

templates:
  - /etc/alertmanager/templates/*.tmpl

# Quiet hours for everything that is not critical (alerts still firing at 07:00 are sent then; what fired and cleared overnight is in the 06:30 daily digest).
# Muted notifications are dropped, not queued: Alertmanager sends a still-firing group at the first group_interval after the window ends.
time_intervals:
  - name: quiet-hours
    time_intervals:
      - times:
          - start_time: "22:00"
            end_time: "24:00"
          - start_time: "00:00"
            end_time: "07:00"
        location: Europe/Zurich

# Channels (prometheus/rules label notify, Docker/grafana/README.md "Alert routing"):
#   critical             Telegram + email, with resolved, any time
#   malware, heartbeat   email (+ Telegram for malware), any time
#   warning / info       Telegram only, no resolved, muted 22:00-07:00
#   notify=digest|weekly no message: listed in the 06:30 DailyDigest or the Monday WeeklyUpdateDigest
route:
  receiver: telegram
  # Group by alert name so "all endpoints down" arrives as ONE message rather than
  # one per host — the difference between a useful page and a pile-on.
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 24h
  routes:
    # Dead man's switch (prometheus/rules/heartbeat.yml): always firing, pinged to healthchecks.io every 4-5 min. healthchecks.io alerts (Telegram + email) when the pings stop.
    - matchers:
        - severity="deadman"
      receiver: healthchecks
      group_wait: 0s
      group_interval: 1m
      # repeat fires on the next group_interval tick after it elapses, so 4m keeps every ping under healthchecks' 5 min period
      repeat_interval: 4m

    # Synthetic test alerts (any label test=...): Telegram only, marked 🧪, never email, never muted. Only sent when someone POSTs one on purpose.
    - matchers:
        - test=~".+"
      receiver: telegram-test
      group_by: ['alertname', 'test']
      group_wait: 0s
      repeat_interval: 720h

    # Daily (06:30) and weekly (Monday 05:00) digests: fire for under an hour, no resolved message, exempt from quiet hours (they are the summary of them).
    - matchers:
        - alertname=~"DailyDigest|WeeklyUpdateDigest"
      receiver: telegram-digest
      group_wait: 0s
      repeat_interval: 168h

    # Listed in a digest instead of a message of its own.
    - matchers:
        - notify=~"digest|weekly"
      receiver: "null"

    # Quarantined ClamAV hits (prometheus/rules/antivirus.yml): email + Telegram with title, file and signature (tg.malware), one message per host batch. Ends after 24 h or on restore, no resolved message.
    - matchers:
        - alertname="MalwareQuarantined"
      receiver: malware
      group_by: ['alertname', 'host']
      repeat_interval: 168h

    # Report-only scan hits: email + Telegram at once, no resolved message.
    - matchers:
        - alertname="MalwareFound"
      receiver: telegram-and-email
      group_by: ['alertname', 'host']
      repeat_interval: 168h

    # A failing Telegram must not be reported over Telegram: email only.
    - matchers:
        - alertname="AlertNotificationsFailing"
        - integration="telegram"
      receiver: email

    - matchers:
        - severity="critical"
      receiver: critical
      repeat_interval: 12h

    # An edge or SSO container down: email too, any time.
    - matchers:
        - alertname="ContainerDown"
        - name=~"traefik|cloudflared|crowdsec|adguard.*|authentik.*"
      receiver: telegram-and-email

    # The dead-man's switch. EMAIL ONLY and deliberately slow: its job is to keep the
    # Brevo SMTP credential demonstrably in use (Brevo deactivates keys after ~3
    # months idle — observed 2026-10-06) and to prove the whole chain monthly.
    # Telegram is pointedly excluded: a bot token does not rot the way an SMTP key
    # does, so sending it there would add noise without testing anything.
    - matchers:
        - severity="heartbeat"
      receiver: heartbeat
      # 28 days. Comfortably inside Brevo's ~3-month idle window, with room for two
      # consecutive failures before the credential could lapse.
      repeat_interval: 672h
      # No grouping delay: there is only ever one of these.
      group_wait: 0s

    # beefy awake 6 h (prometheus/rules/beefy-power.yml): one message per episode (tg.beefyawake); how long it was up is in the daily digest.
    - matchers:
        - alertname="BeefyAwakeLong"
      receiver: telegram-beefy-awake
      repeat_interval: 720h
      mute_time_intervals: [quiet-hours]

    # Known, slow-moving states: once per episode, again only when the rule fires anew (wake loops hold 6 h, rootkit fires on a changed finding set, tower staleness only after tower was awake at scan time).
    - matchers:
        - alertname=~"BeefyWakeLoop|TowerWakeLoop|RootkitWarning|SecurityScanStale|ClamavScanStale"
      receiver: telegram
      repeat_interval: 720h
      mute_time_intervals: [quiet-hours]

    # Info: Telegram only, at most weekly.
    - matchers:
        - severity="info"
      receiver: telegram
      repeat_interval: 168h
      mute_time_intervals: [quiet-hours]

    # Everything else (warning): Telegram only, daily repeat. The root route cannot carry mute_time_intervals, hence this catch-all.
    - receiver: telegram
      mute_time_intervals: [quiet-hours]

receivers:
  - name: "null"

  # Critical alerts go to BOTH, so an outage still reaches you when one channel is
  # broken — which is exactly the failure this whole setup exists to stop happening
  # silently.
  #
  # One alias, not a list. alerts@holy-grail.ch is a Cloudflare Email Routing rule
  # that fans out to whoever should get alerts, so changing recipients is a dashboard
  # edit rather than a config change and a container restart. Alertmanager cannot
  # query Authentik for group membership, so an alias is the closest thing to "the
  # admin group" that SMTP can express.
  - name: critical
    email_configs:
      - to: 'alerts@example.com'
        send_resolved: true
        headers:
          Subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: true
        message: '{{ template "tg.message" . }}'

  # Like critical, without the resolved message (malware report, edge/SSO container down).
  - name: telegram-and-email
    email_configs:
      - to: 'alerts@example.com'
        send_resolved: false
        headers:
          Subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: false
        message: '{{ template "tg.message" . }}'

  # Like telegram-and-email, Telegram in the malware layout.
  - name: malware
    email_configs:
      - to: 'alerts@example.com'
        send_resolved: false
        headers:
          Subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} {{ .CommonLabels.host }}'
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: false
        message: '{{ template "tg.malware" . }}'

  - name: healthchecks
    webhook_configs:
      - url_file: /secrets/healthchecks_url
        send_resolved: false

  - name: heartbeat
    email_configs:
      - to: 'alerts@example.com'
        send_resolved: false
        headers:
          Subject: '[HEARTBEAT] alerting pipeline is alive'

  # Email only, for alerts about Telegram itself.
  - name: email
    email_configs:
      - to: 'alerts@example.com'
        send_resolved: false
        headers:
          Subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'

  - name: telegram
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: false
        message: '{{ template "tg.message" . }}'

  - name: telegram-beefy-awake
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: false
        message: '{{ template "tg.beefyawake" . }}'

  - name: telegram-digest
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: false
        message: '{{ template "tg.digest" . }}'

  # Synthetic tests. Same group chat (no separate test chat exists); the 🧪 prefix marks them.
  - name: telegram-test
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: false
        message: '{{ template "tg.test" . }}'

# Stop a whole-edge outage from paging twice. group_by collapses same-alertname
# fan-out, but the aggregate and per-endpoint alerts have DIFFERENT alertnames, so
# without inhibition a plugin-failure outage sends AllPublicEndpointsDown AND one
# PublicEndpointDown per host. And a dead prober (BlackboxExporterDown) makes every
# probe-derived alert meaningless, so those are muted while it is down.
inhibit_rules:
  - source_matchers:
      - 'alertname="AllPublicEndpointsDown"'
    target_matchers:
      - 'alertname="PublicEndpointDown"'

  - source_matchers:
      - 'alertname="BlackboxExporterDown"'
    target_matchers:
      - 'alertname=~"PublicEndpointDown|LanLockedEndpointNotLocked|AllPublicEndpointsDown|AdGuardDnsResolutionFailing|WakeGatedEndpointNotGated|PublicPathDown|CloudflareTunnelDown|CloudflaredTunnelDown"'

  # Edge dead (all LAN probes fail) or tunnel dead (all Cloudflare probes fail): one page, not one per route.
  - source_matchers:
      - 'alertname=~"AllPublicEndpointsDown|CloudflareTunnelDown|CloudflaredTunnelDown"'
    target_matchers:
      - 'alertname="PublicPathDown"'

  # cloudflared's own HA-connection alert is the root cause; the outside-in tunnel alert adds nothing.
  - source_matchers:
      - 'alertname="CloudflaredTunnelDown"'
    target_matchers:
      - 'alertname="CloudflareTunnelDown"'
