# Alertmanager — TEMPLATE. Copy to alertmanager.yml (gitignored) and fill in the
# marked values. The live file is not committed because this repo is public.
#
# Alertmanager does NOT expand ${ENV_VARS}, so values are written in literally.
# Secrets use the *_file options, which it does support, and live in secrets/.
#
# Both channels are ACTIVE and both were verified end to end by POSTing a synthetic
# alert to /api/v2/alerts — not assumed. Email proved itself on 2026-10-06 07:59
# (FIRING) / 08:04 (RESOLVED); Telegram likewise against the "holy grail alerts"
# group.
#
# Why Alertmanager and not Grafana contact points: the rules already live in
# prometheus/rules/*.yml, version-controlled and visible in the Prometheus UI.
# Grafana contact points only fire for GRAFANA-managed rules, so using them would
# have meant rewriting every rule in Grafana's format and leaving the Prometheus
# ones dead.
global:
  resolve_timeout: 5m
  # Reuses the Brevo relay Authentik already sends through: one mail account to keep
  # alive, one sender reputation, and no-reply@holy-grail.ch is already verified with
  # Brevo. The password is duplicated into secrets/smtp_password because there is no
  # shared secret store here yet.
  smtp_from: "Holy-Grail Alerts <no-reply@holy-grail.ch>"
  smtp_smarthost: "smtp-relay.brevo.com:587"
  smtp_auth_username: "YOUR_BREVO_SMTP_LOGIN"
  smtp_auth_password_file: /secrets/smtp_password
  smtp_require_tls: true

templates:
  - /etc/alertmanager/telegram.tmpl

route:
  receiver: admins
  # Group by alert name so "all endpoints down" arrives as ONE message rather than
  # one per host — the difference between a useful page and a pile-on.
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  routes:
    # Dead man's switch (prometheus/rules/heartbeat.yml): always firing, pinged to healthchecks.io every 4-5 min. healthchecks.io alerts (Telegram + email) when the pings stop.
    - matchers:
        - severity="deadman"
      receiver: healthchecks
      group_wait: 0s
      group_interval: 1m
      # repeat fires on the next group_interval tick after it elapses, so 4m keeps every ping under healthchecks' 5 min period
      repeat_interval: 4m
    # Weekly digest (prometheus/rules/weekly-digest.yml): fires Monday 05:00 for one hour. No resolved message, which would repeat the whole digest an hour later.
    - matchers:
        - alertname="WeeklyUpdateDigest"
      receiver: telegram-digest
      group_wait: 0s
      repeat_interval: 168h

    # Nightly auto-update summary (prometheus/rules/auto-updates.yml): fires for the hour after the 03:10 run, same no-resolved receiver.
    - matchers:
        - alertname="AutoUpdateNightly"
      receiver: telegram-digest
      group_wait: 0s
      repeat_interval: 168h

    # New fixable CVE findings (prometheus/rules/security-posture.yml): one message per batch, nothing when they age out after 24 h.
    - matchers:
        - alertname="NewFixableImageVulnerability"
      receiver: telegram-once
      group_by: ['alertname']
      repeat_interval: 168h

    # A failing Telegram must not be reported over Telegram: email only. Above the info route, which would send it to Telegram.
    - matchers:
        - alertname="AlertNotificationsFailing"
        - integration="telegram"
      receiver: email

    # "Swiss German not found" (prometheus/rules/media-language.yml): one Telegram per title and state. The rule ends the alert 5 days after it starts, inside repeat_interval, and this receiver sends no resolved message.
    - matchers:
        - alertname="AudioLanguageNotFound"
      receiver: telegram-once
      group_by: ['alertname', 'app', 'title', 'failed']
      repeat_interval: 168h

    # Informational things (container updates) go to Telegram ONLY. They do not
    # deserve an email — a weekly nag by mail is how people learn to filter alerts
    # into the bin, and then miss a real one.
    - matchers:
        - severity="info"
      receiver: telegram
      repeat_interval: 168h     # weekly at most; Cup refreshes Sundays 04:00

    # The dead-man's switch. EMAIL ONLY and deliberately slow: its job is to keep the
    # Brevo SMTP credential demonstrably in use (Brevo deactivates keys after ~3
    # months idle — observed 2026-10-06) and to prove the whole chain monthly.
    # Telegram is pointedly excluded: a bot token does not rot the way an SMTP key
    # does, so sending it there would add noise without testing anything.
    - matchers:
        - severity="heartbeat"
      receiver: heartbeat
      # 28 days. Comfortably inside Brevo's ~3-month idle window, with room for two
      # consecutive failures before the credential could lapse.
      repeat_interval: 672h
      # No grouping delay: there is only ever one of these.
      group_wait: 0s

receivers:
  # Critical alerts go to BOTH, so an outage still reaches you when one channel is
  # broken — which is exactly the failure this whole setup exists to stop happening
  # silently.
  #
  # One alias, not a list. alerts@holy-grail.ch is a Cloudflare Email Routing rule
  # that fans out to whoever should get alerts, so changing recipients is a dashboard
  # edit rather than a config change and a container restart. Alertmanager cannot
  # query Authentik for group membership, so an alias is the closest thing to "the
  # admin group" that SMTP can express.
  - name: admins
    email_configs:
      - to: 'alerts@example.com'
        send_resolved: true
        headers:
          Subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: true
        message: '{{ template "tg.message" . }}'

  # Email only — see the route comment above for why Telegram is excluded.
  - name: healthchecks
    webhook_configs:
      - url_file: /secrets/healthchecks_url
        send_resolved: false

  - name: heartbeat
    email_configs:
      - to: 'alerts@example.com'
        send_resolved: false
        headers:
          Subject: '[HEARTBEAT] alerting pipeline is alive'

  # Email only, for alerts about Telegram itself.
  - name: email
    email_configs:
      - to: 'alerts@example.com'
        send_resolved: true
        headers:
          Subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'

  - name: telegram
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: true
        message: '{{ template "tg.message" . }}'

  # Like telegram, without the resolved message (alerts that end on their own).
  - name: telegram-once
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: false
        message: '{{ template "tg.message" . }}'

  - name: telegram-digest
    telegram_configs:
      - bot_token_file: /secrets/telegram_bot_token
        chat_id: -1001234567890   # <-- your group chat id (NEGATIVE)
        parse_mode: HTML
        send_resolved: false
        message: '{{ template "tg.digest" . }}'

# Stop a whole-edge outage from paging twice. group_by collapses same-alertname
# fan-out, but the aggregate and per-endpoint alerts have DIFFERENT alertnames, so
# without inhibition a plugin-failure outage sends AllPublicEndpointsDown AND one
# PublicEndpointDown per host. And a dead prober (BlackboxExporterDown) makes every
# probe-derived alert meaningless, so those are muted while it is down.
inhibit_rules:
  - source_matchers:
      - 'alertname="AllPublicEndpointsDown"'
    target_matchers:
      - 'alertname="PublicEndpointDown"'

  - source_matchers:
      - 'alertname="BlackboxExporterDown"'
    target_matchers:
      - 'alertname=~"PublicEndpointDown|LanLockedEndpointNotLocked|AllPublicEndpointsDown|AdGuardDnsResolutionFailing|WakeGatedEndpointNotGated|PublicPathDown|CloudflareTunnelDown|CloudflaredTunnelDown"'

  # Edge dead (all LAN probes fail) or tunnel dead (all Cloudflare probes fail): one page, not one per route.
  - source_matchers:
      - 'alertname=~"AllPublicEndpointsDown|CloudflareTunnelDown|CloudflaredTunnelDown"'
    target_matchers:
      - 'alertname="PublicPathDown"'

  # cloudflared's own HA-connection alert is the root cause; the outside-in tunnel alert adds nothing.
  - source_matchers:
      - 'alertname="CloudflaredTunnelDown"'
    target_matchers:
      - 'alertname="CloudflareTunnelDown"'
