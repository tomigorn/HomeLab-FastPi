COMPOSE_PROJECT_NAME=navidrome
TZ=Europe/Zurich
# Login comes only from Authentik via Traefik (pinned 172.24.255.3); every other source gets the normal Navidrome login
ND_EXTAUTH_TRUSTEDSOURCES=172.24.255.3/32
ND_EXTAUTH_USERHEADER=X-authentik-username
ND_EXTAUTH_LOGOUTURL=https://music.holy-grail.ch/outpost.goauthentik.io/sign_out
ND_MUSICFOLDER=/music
ND_DATAFOLDER=/data
ND_DEFAULTDOWNSAMPLINGFORMAT=opus
# Full scan nightly at 23:30; new files are also picked up by the file watcher
ND_SCANNER_SCHEDULE=30 23 * * *
ND_ENABLEINSIGHTSCOLLECTOR=false
ND_LOGLEVEL=info
