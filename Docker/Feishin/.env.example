COMPOSE_PROJECT_NAME=feishin
# Subsonic mode: Navidrome takes the user from the Holy Grail login (X-authentik-username), the password typed in Feishin is ignored
SERVER_TYPE=subsonic
SERVER_URL=https://music.holy-grail.ch
SERVER_NAME=Music
SERVER_LOCK=true
# Served at music.holy-grail.ch/feishin/ (same origin as Navidrome, so the login cookie reaches /rest)
PUBLIC_PATH=/feishin/
ANALYTICS_DISABLED=true
