COMPOSE_PROJECT_NAME=m4b-merge-dashboard

# Caddy image tag
CADDY_TAG=2.10-alpine

# LAN-only bind. Deliberately fastpi's LAN IP and not 0.0.0.0, so the page is
# never exposed on any other interface. There is no auth in front of it.
BIND_ADDRESS=192.168.1.2
HTTP_PORT=8099

# Where orchestrate.py writes progress.json and run.jsonl (mounted read-only)
RUNS_DIR=/home/pi/Projects/Docker/audiobookshelf/m4b-merge/runs
