# system unit, see miniflux-feed-sync.service
[Unit]
Description=Miniflux feed sync every 5 minutes (new users get their feeds soon after the first visit)
Documentation=file:///home/pi/Projects/Docker/Miniflux/README.md

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
