COMPOSE_PROJECT_NAME=avatar-picker

# Base of the avatar image URLs stored in Authentik (and fetched by Jellyfin/Nextcloud).
# Must be on the IdP host: Jellyfin's OIDC plugin only accepts private addresses
# for the issuer host. Traefik serves it to local-networks only (LAN + VPN).
PUBLIC_BASE_URL=https://sso.holy-grail.ch/avatar-img

# Authentik API, reached through Traefik (Authentik sits on its own network since the 2026-10-25 split).
AUTHENTIK_URL=https://sso.holy-grail.ch

# Image tag of the locally built picker image.
AVATAR_PICKER_TAG=local
