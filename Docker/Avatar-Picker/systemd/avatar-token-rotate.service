[Unit]
Description=Rotate the avatar picker's Authentik API token 45 days before it expires, write its expiry metric
Documentation=file:///home/pi/Projects/Docker/Avatar-Picker/README.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
ExecStart=/home/pi/Projects/Docker/Avatar-Picker/scripts/rotate-secrets.sh token-auto
TimeoutStartSec=600
