[Unit]
Description=Daily security posture scan
Documentation=file:///home/pi/Projects/Server/4-Security-Monitoring/README.md

[Timer]
# 04:05 - inside beefy's nightly window: woken at 03:55 by beefy-maintenance-wake, powered off again by its idle watcher around 04:26. Everything that reads beefy runs between 04:00 and 04:25. Outside that window beefy's previous figures stay in place and the staleness alert covers it.
OnCalendar=*-*-* 04:05:00
RandomizedDelaySec=180
# Catch up after downtime: a Pi that was off at 04:05 should still scan, because
# "no scan ran" and "nothing was found" look identical in a dashboard.
Persistent=true

[Install]
WantedBy=timers.target
