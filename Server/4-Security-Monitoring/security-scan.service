[Unit]
Description=Security posture scan (secrets, hygiene, OS and Unraid updates, failed logins, Cup per host)
Documentation=file:///home/pi/Projects/Server/4-Security-Monitoring/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
ExecStart=/usr/bin/python3 /home/pi/Projects/Server/4-Security-Monitoring/security_scan.py secrets patches logins cup
# Bounded. The pass measures ~5s, ~30s more when Cup refreshes (beefy or tower awake); fifteen minutes covers a slow GitHub fetch, SSH timeouts and Cup's refresh without ever overlapping the next firing.
# TimeoutStartSec, not RuntimeMaxSec: RuntimeMaxSec is silently ignored for
# Type=oneshot, so a hung run would sit here until the next boot.
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The two paths it must write, carved back out of ProtectSystem=strict.
ReadWritePaths=/var/lib/security-scan /var/lib/node-exporter/textfile
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
