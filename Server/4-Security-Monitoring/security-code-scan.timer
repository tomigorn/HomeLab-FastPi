[Unit]
Description=Daily CVE check of the images in the repos
Documentation=file:///home/pi/Projects/Server/4-Security-Monitoring/README.md

[Timer]
# 03:40, in the night with the other maintenance. Re-matches cached SBOMs (~30 s, no registry) against the Trivy DB, which is republished about daily (~21:15), so a new CVE shows by the next 03:40. Clear of the 04:10 image scan (shared Trivy cache).
OnCalendar=*-*-* 03:40:00 Europe/Zurich
Persistent=false

[Install]
WantedBy=timers.target
