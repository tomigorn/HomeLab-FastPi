[Unit]
Description=Pull ClamAV results from beefy and tower, collect hit lists; pull beefy's language-not-found textfile
Documentation=file:///home/pi/Projects/Server/4-Security-Monitoring/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
ExecStart=/usr/bin/python3 /home/pi/Projects/Server/4-Security-Monitoring/security_scan.py av media
TimeoutStartSec=300
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The two paths it must write, carved back out of ProtectSystem=strict.
ReadWritePaths=/var/lib/security-scan /var/lib/node-exporter/textfile
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
