[Unit]
Description=Weekly fastpi backup restore test inside beefy's maintenance window
Documentation=file:///home/pi/Projects/Server/5-Backup/README.md

[Timer]
# every Tuesday 04:33, after the 04:06 backup, before the 04:45 end of beefy's window; never wakes beefy
OnCalendar=Tue *-*-* 04:33:00 Europe/Zurich
Persistent=false

[Install]
WantedBy=timers.target
